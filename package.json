{
  "name": "aba-khqr-sandbox",
  "version": "1.0.0",
  "description": "ABA PayWay and NBC Bakong KHQR Sandbox Payment Application & Universal SDK",
  "main": "./dist/sdk/index.js",
  "module": "./dist/sdk/index.js",
  "types": "./dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js",
      "default": "./dist/sdk/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js",
      "default": "./dist/sdk/index.js"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sdk": "tsc -p tsconfig.sdk.json",
    "build:all": "npm run build:sdk && npm run build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "clean": "rm -rf .next dist *.tsbuildinfo"
  },
  "keywords": [
    "aba",
    "payway",
    "khqr",
    "bakong",
    "soramitsu",
    "cambodia",
    "emvco",
    "sdk"
  ],
  "author": "Soramitsu / KWD",
  "license": "MIT",
  "dependencies": {
    "next": "^14.2.35",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "bakong-khqr": "^1.0.20",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
