{
  "name": "aba-khqr-sandbox",
  "version": "1.0.0",
  "description": "ABA PayWay and NBC Bakong KHQR Sandbox Payment Application & Universal SDK",
  "main": "./dist/sdk/index.js",
  "module": "./dist/sdk/index.js",
  "types": "./dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js",
      "default": "./dist/sdk/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js",
      "default": "./dist/sdk/index.js"
    }
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "node ./scripts/build.js",
    "build:next": "next build",
    "build:worker": "node ./scripts/build.js",
    "build:sdk": "tsc -p tsconfig.sdk.json",
    "build:all": "npm run build:sdk && npm run build:next",
    "deploy": "wrangler deploy",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "checkpoint": "pnpm run check && pnpm test && pnpm run build",
    "clean": "rm -rf .next dist *.tsbuildinfo"
  },
  "keywords": [
    "aba",
    "payway",
    "khqr",
    "bakong",
    "soramitsu",
    "cambodia",
    "emvco",
    "sdk"
  ],
  "author": "Soramitsu / KWD",
  "license": "MIT",
  "dependencies": {
    "next": "^15.5.28",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "bakong-khqr": "^1.0.20",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "4.151.2"
  },
  "pnpm": {
    "overrides": {
      "axios@<0.33.0": "0.35.0",
      "postcss": ">=8.5.23",
      "undici": "^7.30.1",
      "glob@<11.0.1": "11.1.0",
      "follow-redirects@<1.16.2": "1.16.2",
      "minimatch@9": "11.0.5",
      "minimatch@10": "11.0.5"
    }
  }
}
